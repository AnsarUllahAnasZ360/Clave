# =============================================================================
# Clave — Developer Environment Setup
# =============================================================================
#
# Copy this file to .env.local and fill in the values for your own environment.
# Variables marked [REQUIRED] are needed for the app to start.
# Variables marked [AI] are needed for AI features (chat, agents, RAG).
# Variables marked [OPTIONAL] can be left blank — the app works without them.
#
# -----------------------------------------------------------------------------
# SETUP STEPS
# -----------------------------------------------------------------------------
#
# 1. Install dependencies:
#      bun install
#
# 2. Create a free Convex account at https://convex.dev
#    then run `npx convex dev` — it will:
#      - Create a dev deployment for you
#      - Auto-populate CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL in .env.local
#
# 3. Set Convex-side environment variables (server secrets, not in .env.local):
#      npx convex env set KEY "value"
#    See the "CONVEX ENV VARS" section below for the full list.
#
# 4. Start the dev server:
#      bun run dev           # Convex + Next.js together (port 4000)
#      bun run dev:next      # Next.js only (if Convex is already running)
#
# 5. Open http://localhost:4000
#    Use /dev-login to sign in without Google OAuth configured.
#
# =============================================================================


# =============================================================================
# SECTION 1 — NEXT.JS LOCAL (.env.local)
# =============================================================================
# These live in your .env.local file on your machine.
# `npx convex dev` auto-writes CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL.

# Dev login bypass — enables the /dev-login route for quick local sign-in
NEXT_PUBLIC_DEV_MODE=true                                             # [OPTIONAL] set true locally

# Convex — auto-populated by `npx convex dev`, do not set manually
CONVEX_DEPLOYMENT=dev:<your-deployment-name>                         # [REQUIRED] e.g. dev:adept-puma-535
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud        # [REQUIRED]
NEXT_PUBLIC_CONVEX_SITE_URL=https://<your-deployment>.convex.site    # [REQUIRED] used for auth HTTP actions

# Azure model routing — only needed if you want to override which Azure deployment
# handles which model. Matches the deployment names you set on Convex (see below).
AZURE_CHAT_MODEL_KIMI_25=                                            # [OPTIONAL] e.g. kimi-k2.5
AZURE_CHAT_MODEL_GPT_5_2=                                            # [OPTIONAL] e.g. gpt-5.2-chat

# GIF Picker — get a free key at https://developers.giphy.com/
NEXT_PUBLIC_GIPHY_API_KEY=                                           # [OPTIONAL]

# App URL (for GitHub OAuth redirect_uri — must match GitHub OAuth App callback URL exactly)
# NEXT_PUBLIC_APP_URL=                     # e.g. http://localhost:4000
#
# GitHub OAuth App callback URL (set in GitHub OAuth App settings):
#   http://localhost:4000/api/github/oauth/callback

# GitHub OAuth App (for repository indexing — set both in .env.local for Next.js and via npx convex env set)
# GITHUB_CLIENT_ID=                        # GitHub OAuth App client ID
# GITHUB_CLIENT_SECRET=                    # GitHub OAuth App client secret
# GITHUB_TOKEN_ENCRYPTION_KEY=             # 64-char hex string (32 bytes) for AES-256-GCM token encryption


# Google Chat Marketplace (Configuration URL signing secret — any random 32+ char string)
# GOOGLE_CHAT_MARKETPLACE_SECRET=
# CHAT_CREDENTIALS_ENCRYPTION_KEY=         # 64-char hex string (32 bytes) for AES-256-GCM — encrypts BYOSA service account JSON

# GIF Picker (optional — get key from https://developers.giphy.com/)
# NEXT_PUBLIC_GIPHY_API_KEY=

# =============================================================================
# SECTION 2 — CONVEX ENV VARS (set via `npx convex env set KEY "value"`)
# =============================================================================
# These are server-side secrets stored on your Convex deployment.
# They are NOT in .env.local — set them once per deployment with the CLI.
# Run `npx convex env list` to see what is currently set.


# --- Auth (Convex Auth) -------------------------------------------------------

# Auto-generated — run once after cloning:
#   npx @convex-dev/auth
# This command generates and sets JWT_PRIVATE_KEY and JWKS automatically.
# JWT_PRIVATE_KEY=                                                   # [REQUIRED] auto-generated
# JWKS=                                                              # [REQUIRED] auto-generated

# The public URL of your deployment, used in auth email links and OAuth callbacks.
# For local dev, this is your Convex site URL (not localhost).
SITE_URL=https://<your-deployment>.convex.site                      # [REQUIRED]

# Google OAuth — create credentials at https://console.cloud.google.com/
# Authorized redirect URI: https://<your-deployment>.convex.site/api/auth/callback/google
AUTH_GOOGLE_ID=                                                      # [REQUIRED for Google sign-in]
AUTH_GOOGLE_SECRET=                                                  # [REQUIRED for Google sign-in]

# Email / OTP auth — get a key at https://resend.com (free tier available)
AUTH_RESEND_KEY=                                                     # [OPTIONAL] enables email OTP + magic links
AUTH_EMAIL_FROM=Clave <noreply@yourdomain.com>                       # [OPTIONAL] verified Resend sender


# --- AI — Azure OpenAI -------------------------------------------------------
# Clave uses Azure OpenAI for chat, embeddings, and transcription.
# Create an Azure OpenAI resource and deploy the required models.
# If you don't have Azure access, AI features will not work — the app still runs.

AZURE_RESOURCE_NAME=                                                 # [AI] Azure OpenAI resource name (not the full URL)
AZURE_API_KEY=                                                       # [AI] Azure OpenAI API key

# Chat model deployment names (as configured in Azure AI Studio)
AZURE_CHAT_MODEL_KIMI_25=kimi-k2.5                                  # [AI] Kimi K2.5 deployment name
AZURE_CHAT_MODEL_GPT_5_2=gpt-5.2-chat                               # [AI] GPT 5.2 deployment name
AZURE_CHAT_MODEL_KIMI_25_API=chat                                    # [OPTIONAL] "chat" | "responses"
AZURE_CHAT_MODEL_GPT_5_2_API=chat                                    # [OPTIONAL] "chat" | "responses"
AZURE_CHAT_API_VERSION=                                              # [OPTIONAL] override Azure chat API version
AZURE_BASE_URL=                                                      # [OPTIONAL] override full Azure base URL

# Embedding model (for RAG / semantic search)
AZURE_EMBEDDING_DEPLOYMENT=                                          # [AI] e.g. text-embedding-3-large

# Transcription (voice dictation)
AZURE_TRANSCRIPTION_DEPLOYMENT=gpt-4o-transcribe                    # [OPTIONAL] default: gpt-4o-transcribe
AZURE_FORO_TRANSCRIBE_DEPLOYMENT=                                    # [OPTIONAL] backward-compat alias
AZURE_TRANSCRIPTION_DIARIZE_DEPLOYMENT=                              # [OPTIONAL] diarized transcription
AZURE_TRANSCRIPTION_MODE=                                            # [OPTIONAL] "standard" | "diarized"
AZURE_TRANSCRIPTION_CHUNKING=server_vad                             # [OPTIONAL] "server_vad" | "none"
AZURE_TRANSCRIPTION_API_VERSION=2025-03-01-preview                  # [OPTIONAL]
AZURE_TRANSCRIPTION_BASE_URL=                                        # [OPTIONAL]

# Realtime / streaming audio (advanced — not required for basic voice)
AZURE_REALTIME_DEPLOYMENT=                                           # [OPTIONAL]
AZURE_REALTIME_API_VERSION=                                          # [OPTIONAL]


# --- GitHub Integration -------------------------------------------------------
# Enables GitHub repo indexing, issue sync, and webhook events.
# Same client ID/secret as your Next.js env vars above — also set on Convex side
# so the backend can make OAuth exchange requests.
GITHUB_CLIENT_ID=                                                    # [OPTIONAL]
GITHUB_CLIENT_SECRET=                                                # [OPTIONAL]
GITHUB_TOKEN_ENCRYPTION_KEY=                                         # [OPTIONAL] same key as .env.local

# Bug reporting — creates GitHub issues from in-app reports
GITHUB_BUG_REPORT_TOKEN=                                             # [OPTIONAL] GitHub PAT with repo scope
GITHUB_REPO_OWNER=                                                   # [OPTIONAL] e.g. AnsarUllahAnasZ360
GITHUB_REPO_NAME=                                                    # [OPTIONAL] e.g. millhouse-web
GITHUB_ISSUE_ASSIGNEE=                                               # [OPTIONAL] GitHub username for auto-assign


# --- Billing (Stripe) ---------------------------------------------------------
# Optional — app runs in unlimited mode without these.
STRIPE_SECRET_KEY=                                                   # [OPTIONAL] sk_test_... or sk_live_...
STRIPE_WEBHOOK_SECRET=                                               # [OPTIONAL] whsec_...


# --- Google Chat Integration --------------------------------------------------
# Optional — enables the Google Chat bot integration.
# Requires a GCP service account with the Chat API enabled.
GOOGLE_CHAT_CREDENTIALS=                                             # [OPTIONAL] full service account JSON (single line)
GOOGLE_CHAT_PROJECT_ID=                                              # [OPTIONAL] GCP project ID
GOOGLE_CHAT_PROJECT_NUMBER=                                          # [OPTIONAL] GCP project number
CHAT_CREDENTIALS_ENCRYPTION_KEY=                                     # [OPTIONAL] same key as .env.local — for BYOSA credential encryption
DEV_MODE=true                                                        # [OPTIONAL] set true for dev deployments — allows global credential connections


# =============================================================================
# SECTION 3 — CI/CD (GitHub Actions Secrets — NOT for local dev)
# =============================================================================
# These are set in your fork's GitHub repo under:
#   Settings → Secrets and variables → Actions
# You only need these if you are running the CI/CD pipeline from your own fork.
# For contributing to the main repo, the maintainer's secrets handle deployments.

# CONVEX_DEPLOY_KEY_PREVIEW   — Convex preview deploy key (format: preview:team:project|base64)
# CONVEX_DEPLOY_KEY_PROD      — Convex production deploy key (format: prod:instance|base64)
# VERCEL_TOKEN                — Vercel personal access token (vercel.com/account/tokens)
