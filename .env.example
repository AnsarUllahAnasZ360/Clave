# Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Collaboration Server
NEXT_PUBLIC_COLLAB_SERVER_URL=

# Auth - JWT (auto-generated by npx @convex-dev/auth)
# JWT_PRIVATE_KEY=
# JWKS=

# Auth - Site URL (set via npx convex env set SITE_URL)
# SITE_URL=

# Convex Environment Variables (set via npx convex env set)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_RESEND_KEY=                       # Resend API key for password reset + email verification OTP
# AUTH_EMAIL_FROM=                       # Verified sender, e.g. "Clave <noreply@goclave.app>"
# AZURE_RESOURCE_NAME=
# AZURE_API_KEY=
# AZURE_CHAT_MODEL_KIMI_25=               # Kimi K2.5 deployment name
# AZURE_CHAT_MODEL_GPT_5_2=               # GPT 5.2 deployment name
# AZURE_CHAT_MODEL_KIMI_25_API=           # "chat" | "responses" (default: "chat")
# AZURE_CHAT_MODEL_GPT_5_2_API=           # "chat" | "responses" (default: "chat")
# AZURE_CHAT_API_VERSION=                 # Optional Azure chat API version override
# AZURE_BASE_URL=                         # Optional full Azure OpenAI base URL override
# AZURE_EMBEDDING_DEPLOYMENT=
# AZURE_TRANSCRIPTION_DEPLOYMENT=         # Transcription deployment (default: "gpt-4o-transcribe")
# AZURE_FORO_TRANSCRIBE_DEPLOYMENT=       # Backward-compatible alias for transcription deployment
# AZURE_TRANSCRIPTION_DIARIZE_DEPLOYMENT= # Optional diarized deployment (e.g. gpt-4o-transcribe-diarize)
# AZURE_TRANSCRIPTION_MODE=               # "standard" | "diarized" (default: auto)
# AZURE_TRANSCRIPTION_CHUNKING=           # "server_vad" | "none" (default: "server_vad")
# AZURE_TRANSCRIPTION_API_VERSION=        # Default: "2025-03-01-preview"
# AZURE_TRANSCRIPTION_BASE_URL=           # Optional transcription base URL override
# AZURE_REALTIME_DEPLOYMENT=              # Optional realtime deployment (gpt-realtime) for live streaming use cases
# AZURE_REALTIME_API_VERSION=             # Optional realtime API version override

# Bug Reporting (set via npx convex env set — requires GitHub personal access token with repo scope)
# GITHUB_BUG_REPORT_TOKEN=
# GITHUB_REPO_OWNER=
# GITHUB_REPO_NAME=
# GITHUB_ISSUE_ASSIGNEE=                  # GitHub username to auto-assign issues

# Stripe Billing (set via npx convex env set — optional, app works without these)
# STRIPE_SECRET_KEY=                       # Stripe secret key (sk_test_... or sk_live_...)
# STRIPE_WEBHOOK_SECRET=                   # Stripe webhook signing secret (whsec_...)

# App URL (for GitHub OAuth redirect_uri — must match GitHub OAuth App callback URL exactly)
# NEXT_PUBLIC_APP_URL=                     # e.g. http://localhost:4000
#
# GitHub OAuth App callback URL (set in GitHub OAuth App settings):
#   http://localhost:4000/api/github/oauth/callback

# GitHub OAuth App (for repository indexing — set both in .env.local for Next.js and via npx convex env set)
# GITHUB_CLIENT_ID=                        # GitHub OAuth App client ID
# GITHUB_CLIENT_SECRET=                    # GitHub OAuth App client secret
# GITHUB_TOKEN_ENCRYPTION_KEY=             # 64-char hex string (32 bytes) for AES-256-GCM token encryption

# Google Chat SDK (set via npx convex env set — required for Google Chat integration)
# GOOGLE_CHAT_CREDENTIALS=                  # Full JSON service account key
# GOOGLE_CHAT_PROJECT_ID=                   # GCP project ID
# GOOGLE_CHAT_PROJECT_NUMBER=               # GCP project number
# REDIS_URL=                                # Upstash Redis URL for Chat SDK state adapter (production)

# GIF Picker (optional — get key from https://developers.giphy.com/)
# NEXT_PUBLIC_GIPHY_API_KEY=

# CI/CD — GitHub Actions Secrets (set in repo Settings → Secrets and variables → Actions)
# CONVEX_DEPLOY_KEY=                       # Convex deploy key (Settings → Deploy Key in Convex dashboard)
# VERCEL_TOKEN=                            # Vercel personal access token (vercel.com/account/tokens)
# VERCEL_ORG_ID=                           # Vercel team/org ID (from .vercel/project.json or dashboard)
# VERCEL_PROJECT_ID=                       # Vercel project ID (from .vercel/project.json or dashboard)
