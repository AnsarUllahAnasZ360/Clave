	"scripts": {
		"dev": "bash scripts/cleanup.sh && bash scripts/dev-bootstrap.sh",
		"dev:clean": "bash scripts/cleanup.sh",
		"dev:next": "bash scripts/dev.sh",
		"dev:next:logged": "bash scripts/dev-with-access-log.sh",
		"dev:convex": "convex dev --typecheck=disable --run-sh \"next dev --turbopack -p ${DEV_PORT:-4000}\"",
		"build": "next build",
		"analyze": "ANALYZE=true next build",
		"start": "next start",
		"lint": "biome check .",
		"lint:gate": "bun run lint",
		"lint:fix": "biome check --fix .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"format:gate": "bun run format:check",
		"clean": "bun run dev:clean",
		"typecheck": "tsc --noEmit",
		"typecheck:gate": "bun run typecheck",
		"test": "vitest",
		"test:unit": "vitest run tests/unit",
		"test:integration": "vitest run tests/integration",
		"test:watch": "vitest --watch",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:gate": "bash scripts/test-gate.sh",
		"test:all": "bash scripts/test-all.sh",
		"test:changed": "bash scripts/test-changed.sh",
		"test:policy": "bash scripts/check-feature-tests.sh",
		"logs:next": "node scripts/next-log-summary.mjs",
		"logs:next:access": "node scripts/next-access-summary.mjs",
		"convex:dev": "convex dev",
		"convex:deploy": "convex deploy",
		"changeset": "changeset",
		"changeset:version": "changeset version",
		"prepare": "if [ -d .git ]; then git config core.hooksPath .husky; fi"
	},
